 R←Test_API_002(stopFlag batchFlag);⎕TRAP;result;qdmx
⍝ Runs "Status"
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')
 R←T._Failed

 :Trap 0
     {}G.Status'Does-not-exist'
     →T.FailsIf 1
 :Else
     qdmx←⎕DMX
     →T.PassesIf'Is not a fully qualified namespace name'≡qdmx.EM
 :EndTrap

 result←G.Status ∆Folder1
 →T.PassesIf(⍉⍪'M' ' ' 'APLSource/help.aplf' '#.Proj_1.Hello')≡result
 result←G.Status'#.Proj_2'
 →T.PassesIf(⍉⍪'?' '?' 'APLSource/help2.aplf' '#.Proj_2.Hello2')≡result

 result←G.Status ∆Folder1
 →T.PassesIf 1=≢result

 result←0 1 G.Status ∆Folder1
 →T.PassesIf 3=2⊃⍴result

 result←1 0 G.Status ∆Folder1
 →T.PassesIf 5 1≡⍴result

 R←T._OK
⍝Done

 R←Test_Stash_011(stopFlag batchFlag);⎕TRAP;dir;rc;msg;buff;parms
⍝ Executes StashListContent with an explicit stash number
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')
 R←T._Failed

 dir←∆StashDir,'/SourceCode'
 'Create!'FilesAndDirs.CheckPath dir

 (⊂'Hello')⎕NPUT dir,'/file_1.txt'
 ∆StashDir ##.APLGit2.Add''
 parms←##.APLGit2.CreateStashPushParms
 parms.addUntracked←1
 parms.folder←∆StashDir
 ##.APLGit2.StashPush parms

 'Create!'FilesAndDirs.CheckPath dir
 (⊂'Hello2')⎕NPUT dir,'/file_2.txt'
 ##.APLGit2.StashPush parms
 →T.GoToTidyUp 2≠≢##.APLGit2.StashList ∆StashDir

 buff←##.APLGit2.StashListContent ∆StashDir 1
 →T.GoToTidyUp~'SourceCode/file_1.txt'≡∊(1+≢∆StashDir)↓¨buff[;1]
 buff←##.APLGit2.StashListContent ∆StashDir 0
 →T.GoToTidyUp~'SourceCode/file_2.txt'≡∊(1+≢∆StashDir)↓¨buff[;1]

 R←T._OK

∆TidyUp:
 ##.APLGit2.StashClear ∆StashDir
 (rc msg)←FilesAndDirs.RmDirByForce dir
 msg Assert 0=rc
⍝Done
